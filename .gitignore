# Heavy runtime binaries and archives
*.AppImage
sushi
*.zip
*.tar.xz
*.tar.gz

# Runtime logs
*.log

# Third-party plugin binaries. These are installed per-machine (see README:
# Portability) and catalogued by URI in plugin-manifest.txt, which is what the
# rig configs actually reference.
plugins/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# elkpy compiles sushi_rpc.proto into the current working directory on first
# import (see grpc_gen.py) — lands in tool/ whenever elkpy runs from there.
*_pb2.py
*_pb2_grpc.py

# Generated rig artefacts (regenerate with `sushi-rig emit` / `capture`)
catalogue.json
state.json

# Claude Code session state and worktrees. Worktrees are full checkouts, so
# this grows to tens of MB and is per-machine scratch, never shared history.
.claude/


# Carla writes its plugin state next to whatever project it loads. The
# supervisor generates projects in the runtime dir, so this should stay empty —
# it appears only if a project is run from here by hand.
amp/Carla/
