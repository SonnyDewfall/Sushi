{
  "_meta": {
    "name": "electric-clean",
    "version": "1.0",
    "description": "Electric guitar \u2014 compressor, overdrive, octave, EQ, chorus, delay, and two reverbs \u2014 a clean room and a big hall",
    "status": "stable",
    "source": "config/src/electric_board.yaml"
  },
  "host_config": {
    "samplerate": 48000
  },
  "tracks": [
    {
      "name": "board",
      "channels": 2,
      "inputs": [
        {
          "engine_bus": 0,
          "track_bus": 0
        }
      ],
      "outputs": [
        {
          "engine_bus": 0,
          "track_bus": 0
        }
      ],
      "plugins": [
        {
          "name": "compressor",
          "type": "lv2",
          "uri": "http://guitarix.sourceforge.net/plugins/gx_compressor#_compressor"
        },
        {
          "name": "eq",
          "type": "lv2",
          "uri": "http://distrho.sf.net/plugins/3BandEQ"
        },
        {
          "name": "chorus",
          "type": "lv2",
          "uri": "http://guitarix.sourceforge.net/plugins/gx_chorus_stereo#_chorus_stereo"
        },
        {
          "name": "octave",
          "type": "lv2",
          "uri": "http://guitarix.sourceforge.net/plugins/gx_oc_2_#_oc_2_"
        },
        {
          "name": "overdrive",
          "type": "lv2",
          "uri": "http://guitarix.sourceforge.net/plugins/gxts9#ts9sim"
        },
        {
          "name": "delay",
          "type": "lv2",
          "uri": "http://drobilla.net/plugins/mda/Delay"
        },
        {
          "name": "hall",
          "type": "lv2",
          "uri": "http://distrho.sf.net/plugins/MaGigaverb"
        },
        {
          "name": "room",
          "type": "lv2",
          "uri": "urn:ardour:a-reverb"
        }
      ]
    }
  ],
  "initial_state": [
    {
      "processor": "board",
      "parameters": {
        "gain": 0.833333,
        "pan": 0.5,
        "mute": 0.0
      }
    },
    {
      "processor": "compressor",
      "bypassed": false,
      "parameters": {
        "RATIO": 0.11,
        "KNEE": 0.1,
        "THRESHOLD": 0.8,
        "RELEASE": 0.05,
        "ATTACK": 0.002,
        "BYPASS": 1.0
      }
    },
    {
      "processor": "eq",
      "bypassed": false,
      "parameters": {
        "Low": 0.5,
        "Mid": 0.53,
        "High": 0.5,
        "Master": 0.51,
        "Low-Mid Freq": 0.22,
        "Mid-High Freq": 0.052632
      }
    },
    {
      "processor": "chorus",
      "bypassed": true,
      "parameters": {
        "Level": 0.91,
        "Delay": 0.77,
        "Depth": 0.03,
        "Freq": 0.08,
        "BYPASS": 1.0
      }
    },
    {
      "processor": "octave",
      "bypassed": true,
      "parameters": {
        "DIRECT": 0.5,
        "OCTAVE1": 0.77,
        "OCTAVE2": 0.0
      }
    },
    {
      "processor": "overdrive",
      "bypassed": true,
      "parameters": {
        "Level": 0.93,
        "Tone": 0.13,
        "Drive": 0.0,
        "BYPASS": 1.0
      }
    },
    {
      "processor": "delay",
      "bypassed": true,
      "parameters": {
        "L Delay": 0.5,
        "R Delay": 0.27,
        "Feedback": 0.7,
        "Fb Tone": 0.5,
        "FX Mix": 0.33,
        "Output": 0.5
      }
    },
    {
      "processor": "hall",
      "bypassed": true,
      "parameters": {
        "damping": 0.7,
        "revtime": 0.030286,
        "roomsize": 0.24975,
        "spread": 0.23,
        "bandwidth": 0.5,
        "tail": 0.25,
        "dry": 1.0,
        "early": 0.25
      }
    },
    {
      "processor": "room",
      "bypassed": false,
      "parameters": {
        "Blend": 0.2,
        "Room Size": 0.51,
        "Enable": 1.0
      }
    }
  ],
  "_amp": {
    "plugin": "nam",
    "model": "amp/models/Neve 2.nam",
    "parameters": {
      "Input Lvl": -4.0,
      "Output Lvl": -0.4,
      "Quality": 1.0
    }
  }
}
