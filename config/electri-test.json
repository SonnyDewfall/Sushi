{
  "_meta": {
    "name": "electri-test",
    "version": "1.0",
    "description": "Electric guitar \u2014 compressor, overdrive, octave, EQ, chorus, delay, reverb",
    "status": "wip",
    "source": "config/src/electric_board.yaml"
  },
  "host_config": {
    "samplerate": 48000
  },
  "tracks": [
    {
      "name": "board",
      "channels": 2,
      "inputs": [
        {
          "engine_bus": 0,
          "track_bus": 0
        }
      ],
      "outputs": [
        {
          "engine_bus": 0,
          "track_bus": 0
        }
      ],
      "plugins": [
        {
          "name": "compressor",
          "type": "lv2",
          "uri": "http://guitarix.sourceforge.net/plugins/gx_compressor#_compressor"
        },
        {
          "name": "eq",
          "type": "lv2",
          "uri": "http://distrho.sf.net/plugins/3BandEQ"
        },
        {
          "name": "overdrive",
          "type": "lv2",
          "uri": "http://guitarix.sourceforge.net/plugins/gxts9#ts9sim"
        },
        {
          "name": "octave",
          "type": "lv2",
          "uri": "http://guitarix.sourceforge.net/plugins/gx_oc_2_#_oc_2_"
        },
        {
          "name": "chorus",
          "type": "lv2",
          "uri": "http://guitarix.sourceforge.net/plugins/gx_chorus_stereo#_chorus_stereo"
        },
        {
          "name": "delay",
          "type": "lv2",
          "uri": "http://drobilla.net/plugins/mda/Delay"
        },
        {
          "name": "reverb",
          "type": "lv2",
          "uri": "http://drobilla.net/plugins/mda/Ambience"
        }
      ]
    }
  ],
  "initial_state": [
    {
      "processor": "board",
      "bypassed": false,
      "parameters": {
        "gain": 0.833333,
        "pan": 0.5,
        "mute": 0.0
      }
    },
    {
      "processor": "compressor",
      "bypassed": false,
      "parameters": {
        "RATIO": 0.052632,
        "KNEE": 0.15,
        "THRESHOLD": 0.716981,
        "RELEASE": 0.05,
        "ATTACK": 0.002,
        "BYPASS": 1.0
      }
    },
    {
      "processor": "eq",
      "bypassed": false,
      "program": 0,
      "parameters": {
        "Low": 0.66,
        "Mid": 0.5,
        "High": 0.45,
        "Master": 0.45,
        "Low-Mid Freq": 0.37,
        "Mid-High Freq": 0.11
      }
    },
    {
      "processor": "overdrive",
      "bypassed": true,
      "parameters": {
        "Level": 0.166667,
        "Tone": 0.333333,
        "Drive": 0.5,
        "BYPASS": 1.0
      }
    },
    {
      "processor": "octave",
      "bypassed": true,
      "parameters": {
        "DIRECT": 0.5,
        "OCTAVE1": 0.5,
        "OCTAVE2": 0.5
      }
    },
    {
      "processor": "chorus",
      "bypassed": true,
      "parameters": {
        "Level": 0.5,
        "Delay": 0.1,
        "Depth": 0.02,
        "Freq": 0.292929,
        "BYPASS": 1.0
      }
    },
    {
      "processor": "delay",
      "bypassed": true,
      "parameters": {
        "L Delay": 0.5,
        "R Delay": 0.27,
        "Feedback": 0.7,
        "Fb Tone": 0.5,
        "FX Mix": 0.33,
        "Output": 0.5
      }
    },
    {
      "processor": "reverb",
      "bypassed": false,
      "parameters": {
        "Size": 0.88,
        "HF Damp": 0.93,
        "Mix": 0.31,
        "Output": 0.57
      }
    }
  ]
}
