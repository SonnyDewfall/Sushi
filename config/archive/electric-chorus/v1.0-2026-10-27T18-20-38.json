{
  "_meta": {
    "name": "electric-chorus",
    "version": "1.0",
    "description": "Electric guitar \u2014 compressor, overdrive, octave, EQ, chorus, delay, and two reverbs \u2014 a clean room and a big hall",
    "status": "stable",
    "source": "config/src/electric_board.yaml",
    "archived_at": "2026-10-27"
  },
  "host_config": {
    "samplerate": 48000
  },
  "tracks": [
    {
      "name": "board",
      "channels": 2,
      "inputs": [
        {
          "engine_bus": 0,
          "track_bus": 0
        }
      ],
      "outputs": [
        {
          "engine_bus": 0,
          "track_bus": 0
        }
      ],
      "plugins": [
        {
          "name": "compressor",
          "type": "lv2",
          "uri": "http://guitarix.sourceforge.net/plugins/gx_compressor#_compressor"
        },
        {
          "name": "eq",
          "type": "lv2",
          "uri": "http://distrho.sf.net/plugins/3BandEQ"
        },
        {
          "name": "chorus",
          "type": "lv2",
          "uri": "http://guitarix.sourceforge.net/plugins/gx_chorus_stereo#_chorus_stereo"
        },
        {
          "name": "overdrive",
          "type": "lv2",
          "uri": "http://guitarix.sourceforge.net/plugins/gxts9#ts9sim"
        },
        {
          "name": "delay",
          "type": "lv2",
          "uri": "http://plugin.org.uk/swh-plugins/lcrDelay"
        },
        {
          "name": "hall",
          "type": "lv2",
          "uri": "http://distrho.sf.net/plugins/MaGigaverb"
        },
        {
          "name": "room",
          "type": "lv2",
          "uri": "urn:ardour:a-reverb"
        },
        {
          "name": "octave_down",
          "type": "lv2",
          "uri": "http://guitarix.sourceforge.net/plugins/gx_detune_#_detune_"
        },
        {
          "name": "octave_up",
          "type": "lv2",
          "uri": "http://guitarix.sourceforge.net/plugins/gx_detune_#_detune_"
        }
      ]
    }
  ],
  "initial_state": [
    {
      "processor": "board",
      "parameters": {
        "gain": 0.833333,
        "pan": 0.5,
        "mute": 0.0
      }
    },
    {
      "processor": "compressor",
      "bypassed": false,
      "parameters": {
        "RATIO": 0.07,
        "KNEE": 0.1,
        "THRESHOLD": 0.74,
        "RELEASE": 0.05,
        "ATTACK": 0.002,
        "BYPASS": 1.0
      }
    },
    {
      "processor": "eq",
      "bypassed": false,
      "parameters": {
        "Low": 0.4,
        "Mid": 0.56,
        "High": 0.66,
        "Master": 0.5,
        "Low-Mid Freq": 0.45,
        "Mid-High Freq": 0.06
      }
    },
    {
      "processor": "chorus",
      "bypassed": false,
      "parameters": {
        "Level": 0.91,
        "Delay": 0.5,
        "Depth": 0.03,
        "Freq": 0.08,
        "BYPASS": 1.0
      }
    },
    {
      "processor": "overdrive",
      "bypassed": true,
      "parameters": {
        "Level": 0.82,
        "Tone": 0.13,
        "Drive": 0.0,
        "BYPASS": 1.0
      }
    },
    {
      "processor": "delay",
      "bypassed": true,
      "parameters": {
        "L Delay": 0.52,
        "R Delay": 0.53,
        "Feedback": 0.25,
        "Fb Tone": 0.5,
        "FX Mix": 0.36,
        "Output": 0.72
      }
    },
    {
      "processor": "hall",
      "bypassed": true,
      "parameters": {
        "damping": 0.0,
        "revtime": 0.01,
        "roomsize": 0.29,
        "spread": 0.01,
        "bandwidth": 0.62,
        "tail": 0.09,
        "dry": 0.81,
        "early": 0.16
      }
    },
    {
      "processor": "room",
      "bypassed": false,
      "parameters": {
        "Blend": 0.2,
        "Room Size": 0.41,
        "Enable": 1.0
      }
    }
  ],
  "_amp": {
    "plugin": "nam",
    "model": "amp/models/Neve 2.nam",
    "parameters": {
      "Input Lvl": 1.2,
      "Output Lvl": 0.0,
      "Quality": 1.0
    }
  }
}
